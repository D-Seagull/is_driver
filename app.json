{
  "expo": {
    "name": "IS Driver",
    "slug": "is-driver",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8bb837ef-9e50-4f36-b896-35fcd5e3920f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "isdriver",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./assets/ios-permissions/en.json",
      "uk": "./assets/ios-permissions/uk.json",
      "pl": "./assets/ios-permissions/pl.json",
      "lt": "./assets/ios-permissions/lt.json",
      "ru": "./assets/ios-permissions/ru.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.isfleet.isdriver",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSCameraUsageDescription": "The app needs camera access to take photos of documents and send them in chat.",
        "NSPhotoLibraryUsageDescription": "The app needs access to your photos to attach images to chats and documents and to set your profile picture.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "The app needs access to your photos to save pictures from chat to your gallery.",
        "NSMicrophoneUsageDescription": "The app needs microphone access to record voice messages in chat.",
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.isfleet.isdriver",
      "permissions": [
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "backgroundColor": "#1E7AFD",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E7AFD",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "The app needs microphone access to record voice messages in chat.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1E7AFD",
          "sounds": [
            "./assets/sounds/push_message.mp3",
            "./assets/sounds/is_alarm.mp3",
            "./assets/sounds/push_message_ios.wav",
            "./assets/sounds/is_alarm_ios.wav"
          ],
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-asset",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "The app needs access to your photos to attach images to chats and documents and to set your profile picture.",
          "savePhotosPermission": "The app needs access to your photos to save pictures from chat to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "dmytro-chaika",
          "project": "is-driver"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "API_URL": "https://api.isfleet.eu",
      "MOCK_AUTH": "false",
      "SENTRY_DSN": "https://51408ebbe9080b8e737b41c579dd89f5@o4512086189080576.ingest.de.sentry.io/4512347009056848",
      "LOGIN_SMS_ENABLED": "true",
      "LOGIN_WHATSAPP_ENABLED": "false",
      "LOGIN_TELEGRAM_ENABLED": "false",
      "LOGIN_MANAGER_EMAIL_ENABLED": "true",
      "MANAGER_LOGIN_CODE_ENABLED": "true",
      "eas": {
        "projectId": "8bb837ef-9e50-4f36-b896-35fcd5e3920f"
      }
    },
    "owner": "d-seadull"
  }
}
