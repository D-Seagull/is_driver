{
  "expo": {
    "name": "IS Driver",
    "slug": "is-driver",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8bb837ef-9e50-4f36-b896-35fcd5e3920f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "isdriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dseadull.isdriver",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Додатку потрібен доступ до камери, щоб знімати фото документів і надсилати їх у чат.",
        "NSPhotoLibraryUsageDescription": "Додатку потрібен доступ до фотографій, щоб прикріплювати зображення в чат і документи та встановлювати аватар.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.isfleet.isdriver",
      "permissions": ["android.permission.ACCESS_NOTIFICATION_POLICY"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "backgroundColor": "#1E7AFD",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/IS-driverapp-img.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E7AFD",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1E7AFD",
          "sounds": [
            "./assets/sounds/push_message.mp3",
            "./assets/sounds/is_alarm.mp3"
          ]
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Додатку потрібен доступ до фотографій, щоб прикріплювати зображення в чат і документи та встановлювати аватар.",
          "savePhotosPermission": "Додатку потрібен доступ до фотографій, щоб зберігати фото з чату у вашу галерею.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "dmytro-chaika",
          "project": "is-driver"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "API_URL": "https://api.isfleet.eu",
      "MOCK_AUTH": "false",
      "SENTRY_DSN": "",
      "LOGIN_SMS_ENABLED": "true",
      "LOGIN_WHATSAPP_ENABLED": "false",
      "LOGIN_TELEGRAM_ENABLED": "true",
      "LOGIN_MANAGER_EMAIL_ENABLED": "true",
      "eas": {
        "projectId": "8bb837ef-9e50-4f36-b896-35fcd5e3920f"
      }
    },
    "owner": "d-seadull"
  }
}
